// Control file naming the DUT signals dv/uvm/core_ibex reaches through UVM's
// HDL access.
//
// A signal is visible to VPI only when it is marked public, and a write is
// accepted only when it is public_flat_rw. Nothing is public by default, so a
// path the testbench asks for by name has to be listed here or
// vpi_handle_by_name returns null. That null surfaces in
// shims/uvm_dpi_verilator.cc as "unable to locate hdl path (...)" and the
// DV_CHECK_FATAL wrapped around the call in core_ibex_test_lib.sv turns it into
// a fatal.
//
// force and release are a second, separate permission: vpi_put_value with
// vpiForceFlag or vpiReleaseFlag is rejected on a signal that is not also
// forceable. Only the signals the tests actually force carry it, because
// forceable is what makes a signal a VlForceVec, and README.md records what
// that costs elsewhere in this build.
//
// Every entry below is a path built in
// deps/ibex/dv/uvm/core_ibex/tests/core_ibex_test_lib.sv. Several are assembled
// at run time from a base path plus a subpath, so the grouping is by test
// class. -var matches ports, nets and variables; -param matches parameters and
// localparams; a name inside a generate block is matched by the module that
// contains the block.
//
// Entries that match nothing are silently ignored, which is what happens to the
// SecureIbex and ICache signals in configurations that do not build them.
//
// Two things this file cannot contain: a backtick, which starts a directive
// even inside a comment, and a comment whose first word is the name of this
// tool, which is read as a metacomment.
//
// SPDX-License-Identifier: Apache-2.0

`verilator_config

// ---------------------------------------------------------------------------
// core_ibex_pc_intg_test
//   <core>            = core_ibex_tb_top.dut.u_ibex_top.u_ibex_core
//   <core>.core_busy_o                              read
//   <core>.alert_major_internal_o                   read
//   <core>.if_stage_i.pc_if_o                       read, force, release
//   <core>.if_stage_i.g_secure_pc.prev_instr_seq_d  read   (PCIncrCheck only)

public_flat_rd -module "ibex_core"     -var "core_busy_o"
public_flat_rd -module "ibex_core"     -var "alert_major_internal_o"
public_flat_rd -module "ibex_if_stage" -var "prev_instr_seq_d"
public_flat_rw -module "ibex_if_stage" -var "pc_if_o"
forceable      -module "ibex_if_stage" -var "pc_if_o"

// ---------------------------------------------------------------------------
// core_ibex_rf_intg_test
//   <top>             = core_ibex_tb_top.dut.u_ibex_top
//   <top>.RegFileDataWidth                             read (localparam)
//   <top>.gen_lockstep.u_ibex_lockstep.LockstepOffset  read (parameter)
//   <top>.rf_rdata_a, <top>.rf_rdata_b                 read, force, release
//   <top>.u_ibex_core.instr_valid_id                   read
//   <top>.alert_major_internal_o                       read

public_flat_rd -module "ibex_top"      -param "RegFileDataWidth"
public_flat_rd -module "ibex_lockstep" -param "LockstepOffset"
public_flat_rd -module "ibex_core"     -var "instr_valid_id"
public_flat_rd -module "ibex_top"      -var "alert_major_internal_o"
public_flat_rw -module "ibex_top"      -var "rf_rdata_a"
public_flat_rw -module "ibex_top"      -var "rf_rdata_b"
forceable      -module "ibex_top"      -var "rf_rdata_a"
forceable      -module "ibex_top"      -var "rf_rdata_b"

// ---------------------------------------------------------------------------
// core_ibex_rf_addr_intg_test
//   <top>.gen_regfile_ff.register_file_i.raddr_{a,b}_i   read, force, release
//   <top>.gen_lockstep.u_ibex_lockstep
//         .gen_shadow_regfile_ff.register_file_shadow_i
//         .raddr_{a,b}_i                                 read, force, release
//   <top>.gen_lockstep.u_ibex_lockstep.u_shadow_core
//         .gen_regfile_ecc.rf_ecc_err_{a,b}              read
//
// Both register files are instances of ibex_register_file_ff, so one pair of
// entries covers the main core and the shadow core.
//
// A force on raddr_a_i/raddr_b_i is accepted and reads back, but the register
// file does not see it: ibex_register_file_ff reads rf_reg[raddr_a_i], and the
// forced value is not substituted inside an unpacked-array index. See
// README.md.

public_flat_rw -module "ibex_register_file_ff" -var "raddr_a_i"
public_flat_rw -module "ibex_register_file_ff" -var "raddr_b_i"
forceable      -module "ibex_register_file_ff" -var "raddr_a_i"
forceable      -module "ibex_register_file_ff" -var "raddr_b_i"
public_flat_rd -module "ibex_core"             -var "rf_ecc_err_a"
public_flat_rd -module "ibex_core"             -var "rf_ecc_err_b"

// ---------------------------------------------------------------------------
// core_ibex_ram_intg_test
//   <top>.gen_rams.gen_rams_inner[0..1].gen_scramble_rams.{tag,data}_bank
//         .<one of the prim_ram_1p_scr signals>            read, force, release
//   ...same.u_prim_ram_1p_adv
//         .<one of the prim_ram_1p_adv signals>            read, force, release
//   <top>.alert_major_internal_o                           read (above)
//
// The test picks one signal from each list at random per run, so all sixteen
// have to be reachable.

public_flat_rw -module "prim_ram_1p_scr" -var "write_en_d"
public_flat_rw -module "prim_ram_1p_scr" -var "write_en_q"
public_flat_rw -module "prim_ram_1p_scr" -var "addr_collision_d"
public_flat_rw -module "prim_ram_1p_scr" -var "addr_collision_q"
public_flat_rw -module "prim_ram_1p_scr" -var "write_scr_pending_d"
public_flat_rw -module "prim_ram_1p_scr" -var "write_pending_q"
public_flat_rw -module "prim_ram_1p_scr" -var "rvalid_q"
public_flat_rw -module "prim_ram_1p_scr" -var "read_en_buf"
forceable      -module "prim_ram_1p_scr" -var "write_en_d"
forceable      -module "prim_ram_1p_scr" -var "write_en_q"
forceable      -module "prim_ram_1p_scr" -var "addr_collision_d"
forceable      -module "prim_ram_1p_scr" -var "addr_collision_q"
forceable      -module "prim_ram_1p_scr" -var "write_scr_pending_d"
forceable      -module "prim_ram_1p_scr" -var "write_pending_q"
forceable      -module "prim_ram_1p_scr" -var "rvalid_q"
forceable      -module "prim_ram_1p_scr" -var "read_en_buf"

public_flat_rw -module "prim_ram_1p_adv" -var "req_d"
public_flat_rw -module "prim_ram_1p_adv" -var "req_q"
public_flat_rw -module "prim_ram_1p_adv" -var "write_d"
public_flat_rw -module "prim_ram_1p_adv" -var "write_q"
public_flat_rw -module "prim_ram_1p_adv" -var "rvalid_d"
public_flat_rw -module "prim_ram_1p_adv" -var "rvalid_q"
public_flat_rw -module "prim_ram_1p_adv" -var "rvalid_sram_d"
public_flat_rw -module "prim_ram_1p_adv" -var "rvalid_sram_q"
forceable      -module "prim_ram_1p_adv" -var "req_d"
forceable      -module "prim_ram_1p_adv" -var "req_q"
forceable      -module "prim_ram_1p_adv" -var "write_d"
forceable      -module "prim_ram_1p_adv" -var "write_q"
forceable      -module "prim_ram_1p_adv" -var "rvalid_d"
forceable      -module "prim_ram_1p_adv" -var "rvalid_q"
forceable      -module "prim_ram_1p_adv" -var "rvalid_sram_d"
forceable      -module "prim_ram_1p_adv" -var "rvalid_sram_q"

// ---------------------------------------------------------------------------
// core_ibex_icache_intg_test
//   <top>.TagSizeECC, <top>.LineSizeECC                  read (localparams)
//   <top>.ic_tag_rdata[way], <top>.ic_data_rdata[way]    read, force, release
//   <top>.u_ibex_core.if_stage_i.gen_icache.icache_i
//         .lookup_valid_ic1, .tag_hit_ic1                read
//
// ic_tag_rdata and ic_data_rdata are unpacked arrays indexed by way; VPI
// addresses one element as name[way], and public_flat_rw on the array covers
// every element.

public_flat_rd -module "ibex_top"    -param "TagSizeECC"
public_flat_rd -module "ibex_top"    -param "LineSizeECC"
public_flat_rw -module "ibex_top"    -var "ic_tag_rdata"
public_flat_rw -module "ibex_top"    -var "ic_data_rdata"
forceable      -module "ibex_top"    -var "ic_tag_rdata"
forceable      -module "ibex_top"    -var "ic_data_rdata"
public_flat_rd -module "ibex_icache" -var "lookup_valid_ic1"
public_flat_rd -module "ibex_icache" -var "tag_hit_ic1"
