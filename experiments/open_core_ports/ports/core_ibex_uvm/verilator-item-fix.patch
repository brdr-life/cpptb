+                        new AstLambdaArgRef{nodep->fileline(), RANDOMIZE_WITH_OBJ_NAME, false},
                         VFlagChildDType{}, nodep->name(), argsp};
                     nodep->replaceWith(newp);
                     VL_DO_DANGLING(pushDeletep(nodep), nodep);
