+// Name of the implicit lambda argument bound to the object being randomized inside a
+// 'randomize() with' constraint. Array-method 'with' clauses have a default iterator
+// named 'item' (IEEE 1800-2023 7.12.1), but randomize() with has no such iterator, so
+// reusing that name shadows any user variable called 'item' referenced by the
+// constraint. Must stay outside the user identifier space.
+static const char* const RANDOMIZE_WITH_OBJ_NAME = "__Vrandwith_obj";
+
 static string extractDottedPath(AstNode* nodep, bool& hasPartSelect) {
     if (AstParseRef* const refp = VN_CAST(nodep, ParseRef)) {
         return refp->name();
@@ -2195,7 +2202,8 @@ class LinkDotFindVisitor final : public VNVisitor {
