name: "lowrisc:dv:core_ibex_cpptb:0.1"
description: "core_ibex_tb_top.sv without the UVM, for the cpptb port"

filesets:
  files_sim:
    depend:
      # The design under test, exactly as dv/uvm/core_ibex compiles it.
      - lowrisc:ibex:ibex_top_tracing
      # prim_secded_pkg, for the bus integrity the wrapper computes in place of
      # ibex_mem_intf_response_seq's call to the same function. It arrives
      # through ibex_top anyway; naming it means the wrapper does not depend on
      # that remaining true.
      - lowrisc:prim:secded
    files:
      - core_ibex_cpptb_tb_top.sv
    file_type: systemVerilogSource

targets:
  sim:
    filesets:
      - files_sim
    toplevel: core_ibex_cpptb_tb_top
