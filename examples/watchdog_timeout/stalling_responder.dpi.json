{
  "schema_version": 1,
  "module": "stalling_responder",
  "top_module": "dpi_stalling_responder",
  "namespace": "cpptb::examples::watchdog_timeout",
  "root_type": "StallingResponderDut",
  "frontend": "slang",
  "frontend_options": {
    "slang": {
      "standard": "1800-2023"
    },
    "verilator_json": {
      "args": ["-Wno-TIMESCALEMOD"]
    }
  },
  "codegen": {
    "static_binding": true
  },
  "sources": ["stalling_responder.sv"],
  "clocks": [
    {
      "port": "clk",
      "source": "generated",
      "half_period": "5ns",
      "primary": true
    }
  ],
  "edge_observers": ["response_valid"],
  "run": {
    "init_function": "cpptb_dpi_init",
    "step_function": "cpptb_dpi_step",
    "next_deadline_function": "cpptb_dpi_next_timer_deadline",
    "iteration_plusarg": "CPPTB_WATCHDOG_TIMEOUT_ITERS",
    "default_iterations": 8,
    "timeprecision": "1ps"
  },
  "path_rules": [
    {
      "prefix": "request_",
      "path": "request_payload"
    },
    {
      "prefix": "response_",
      "path": "response"
    }
  ],
  "type_names": {
    "": "StallingResponderDut",
    "request_payload": "RequestPayload",
    "response": "Response"
  },
  "outputs": {
    "cpp_dut": "generated/stalling_responder_dut.hpp",
    "cpp_binding": "generated/stalling_responder_binding.hpp",
    "sv_wrapper": "generated/dpi_stalling_responder.sv",
    "cpp_include": "examples/watchdog_timeout/generated/stalling_responder_dut.hpp"
  }
}
