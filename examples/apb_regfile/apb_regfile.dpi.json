{
  "schema_version": 1,
  "module": "apb_regfile",
  "top_module": "dpi_apb_regfile",
  "namespace": "cpptb::examples::apb_regfile",
  "root_type": "ApbRegfileDut",
  "frontend": "slang",
  "frontend_options": {
    "slang": {
      "standard": "1800-2023"
    },
    "verilator_json": {
      "args": ["-Wno-TIMESCALEMOD"]
    }
  },
  "codegen": {
    "static_binding": true
  },
  "sources": ["apb_regfile.sv"],
  "clocks": [
    {
      "port": "clk",
      "source": "generated",
      "half_period": "5ns",
      "primary": true
    }
  ],
  "run": {
    "init_function": "cpptb_dpi_init",
    "step_function": "cpptb_dpi_step",
    "next_deadline_function": "cpptb_dpi_next_timer_deadline",
    "iteration_plusarg": "CPPTB_APB_REGFILE_ITERS",
    "default_iterations": 12,
    "timeprecision": "1ps"
  },
  "path_rules": [
    {
      "prefix": "apb_",
      "path": "apb"
    }
  ],
  "type_names": {
    "": "ApbRegfileDut",
    "apb": "ApbSignals"
  },
  "outputs": {
    "cpp_dut": "generated/apb_regfile_dut.hpp",
    "cpp_binding": "generated/apb_regfile_binding.hpp",
    "sv_wrapper": "generated/dpi_apb_regfile.sv",
    "cpp_include": "examples/apb_regfile/generated/apb_regfile_dut.hpp"
  }
}
