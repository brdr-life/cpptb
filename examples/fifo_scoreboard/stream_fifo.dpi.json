{
  "schema_version": 1,
  "module": "stream_fifo",
  "top_module": "dpi_stream_fifo",
  "namespace": "cpptb::examples::fifo_scoreboard",
  "root_type": "StreamFifoDut",
  "frontend": "slang",
  "frontend_options": {
    "slang": {
      "standard": "1800-2023"
    },
    "verilator_json": {
      "args": ["-Wno-TIMESCALEMOD"]
    }
  },
  "codegen": {
    "static_binding": true
  },
  "sources": ["stream_fifo.sv"],
  "clocks": [
    {
      "port": "clk",
      "source": "generated",
      "half_period": "5ns",
      "primary": true
    }
  ],
  "run": {
    "init_function": "cpptb_dpi_init",
    "step_function": "cpptb_dpi_step",
    "next_deadline_function": "cpptb_dpi_next_timer_deadline",
    "iteration_plusarg": "CPPTB_FIFO_SCOREBOARD_ITERS",
    "default_iterations": 24,
    "timeprecision": "1ps"
  },
  "path_rules": [
    {
      "prefix": "in_",
      "path": "in"
    },
    {
      "prefix": "out_",
      "path": "out"
    }
  ],
  "type_names": {
    "": "StreamFifoDut",
    "in": "StreamInput",
    "out": "StreamOutput"
  },
  "outputs": {
    "cpp_dut": "generated/stream_fifo_dut.hpp",
    "cpp_binding": "generated/stream_fifo_binding.hpp",
    "sv_wrapper": "generated/dpi_stream_fifo.sv",
    "cpp_include": "examples/fifo_scoreboard/generated/stream_fifo_dut.hpp"
  }
}
