{
  "schema_version": 1,
  "module": "peripheral_suite_dut",
  "top_module": "dpi_peripheral_suite",
  "namespace": "cpptb::benchmarks::peripheral_suite",
  "root_type": "PeripheralSuiteDut",
  "frontend": "slang",
  "frontend_options": {
    "slang": {
      "standard": "1800-2023",
      "args": [
        "--timescale=1ns/1ns"
      ]
    },
    "verilator_json": {
      "args": [
        "-Wno-MULTIDRIVEN",
        "-Wno-TIMESCALEMOD",
        "-Wno-WIDTHTRUNC",
        "-Wno-WIDTHEXPAND"
      ]
    }
  },
  "sources": [
    "../../rtl/apb_timer_regs_core_pkg.sv",
    "../../rtl/apb_timer_regs_core.sv",
    "../../rtl/timer_peakrdl.sv",
    "../../rtl/apb_timer_peakrdl.sv",
    "../../rtl/apb_spi_master_regs_core_pkg.sv",
    "../../rtl/apb_spi_master_regs_core.sv",
    "../../rtl/spi_master_apb_if_peakrdl.sv",
    "../../rtl/apb_i2c_regs_core_pkg.sv",
    "../../rtl/apb_i2c_regs_core.sv",
    "../../rtl/i2c_master_bit_ctrl.sv",
    "../../rtl/i2c_master_byte_ctrl.sv",
    "../../rtl/apb_i2c_peakrdl.sv",
    "../../rtl/peripheral_suite_dut.sv"
  ],
  "include_dirs": [
    "../../rtl"
  ],
  "parameters": {
    "APB_ADDR_WIDTH": 12,
    "TIMER_CNT": 2,
    "SPI_BUFFER_DEPTH": 10,
    "SPI_LOG_BUFFER_DEPTH": 4
  },
  "clocks": [
    {
      "port": "HCLK",
      "source": "generated",
      "half_period": "1ns",
      "primary": true
    }
  ],
  "run": {
    "init_function": "cpptb_dpi_init",
    "step_function": "cpptb_dpi_step",
    "next_deadline_function": "cpptb_dpi_next_timer_deadline",
    "iteration_plusarg": "PERIPHERAL_SUITE_ITERS",
    "default_iterations": 1000,
    "timeprecision": "1ps"
  },
  "path_rules": [
    {
      "prefix": "timer_",
      "path": "timer",
      "groups": [
        {
          "path": "apb",
          "members": [
            "PADDR",
            "PWDATA",
            "PWRITE",
            "PSEL",
            "PENABLE",
            "PRDATA",
            "PREADY",
            "PSLVERR"
          ]
        }
      ]
    },
    {
      "prefix": "spi_",
      "path": "spi",
      "groups": [
        {
          "path": "apb",
          "members": [
            "PADDR",
            "PWDATA",
            "PWRITE",
            "PSEL",
            "PENABLE",
            "PRDATA",
            "PREADY",
            "PSLVERR"
          ]
        }
      ]
    },
    {
      "prefix": "i2c_",
      "path": "i2c",
      "groups": [
        {
          "path": "apb",
          "members": [
            "PADDR",
            "PWDATA",
            "PWRITE",
            "PSEL",
            "PENABLE",
            "PRDATA",
            "PREADY",
            "PSLVERR"
          ]
        }
      ]
    }
  ],
  "type_names": {
    "": "PeripheralSuiteDut",
    "timer": "TimerDut",
    "timer.apb": "ApbBus",
    "spi": "SpiDut",
    "spi.apb": "ApbBus",
    "i2c": "I2cDut",
    "i2c.apb": "ApbBus"
  },
  "outputs": {
    "cpp_dut": "generated/peripheral_suite_dut.hpp",
    "cpp_binding": "generated/peripheral_suite_binding.hpp",
    "sv_wrapper": "generated/dpi_peripheral_suite.sv",
    "cpp_include": "benchmarks/peripheral_suite/testbenches/cpp_dpi/generated/peripheral_suite_dut.hpp"
  }
}
