{
  "schema_version": 1,
  "module": "authoring_core_dut",
  "top_module": "dpi_authoring_core",
  "namespace": "cpptb::benchmarks::authoring_core",
  "root_type": "AuthoringCoreDut",
  "frontend": "slang",
  "frontend_options": {
    "slang": {
      "standard": "1800-2023",
      "args": ["--timescale=1ns/1ps"]
    },
    "verilator_json": {
      "args": ["-Wno-TIMESCALEMOD"]
    }
  },
  "codegen": {
    "static_binding": true
  },
  "sources": ["../../rtl/authoring_core_dut.sv"],
  "clocks": [],
  "edge_observers": ["rsp_valid"],
  "auto_edge_observers": true,
  "port_transport": {
    "wide137_i": "on_demand",
    "wide137_o": "on_demand",
    "array_wide_i": "on_demand",
    "array_wide_o": "on_demand"
  },
  "run": {
    "init_function": "authoring_core_dpi_init",
    "step_function": "authoring_core_dpi_step",
    "pull_outputs_function": "authoring_core_dpi_pull_outputs",
    "next_deadline_function": "authoring_core_dpi_next_timer_deadline",
    "edge_interest_function": "authoring_core_dpi_edge_interest",
    "starvation_function": "authoring_core_dpi_report_starvation",
    "clock_config_function": "authoring_core_dpi_clock_config",
    "phase_dispatch_function": "authoring_core_dpi_phase_dispatch",
    "dynamic_clocks": true,
    "iteration_plusarg": "AUTHORING_CORE_ITERS",
    "default_iterations": 10000,
    "timeprecision": "1ps"
  },
  "outputs": {
    "cpp_dut": "generated/authoring_core_dut.hpp",
    "cpp_binding": "generated/authoring_core_binding.hpp",
    "sv_wrapper": "generated/dpi_authoring_core.sv",
    "cpp_include": "benchmarks/authoring_core/testbenches/cpp_dpi/generated/authoring_core_dut.hpp"
  }
}
