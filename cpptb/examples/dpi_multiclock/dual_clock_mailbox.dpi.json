{
  "schema_version": 1,
  "module": "dual_clock_mailbox",
  "top_module": "dpi_dual_clock_mailbox",
  "namespace": "cpptb::examples::dpi_multiclock",
  "root_type": "DualClockMailboxDut",
  "frontend": "slang",
  "frontend_options": {
    "slang": {
      "standard": "1800-2023"
    },
    "verilator_json": {
      "args": [
        "-Wno-TIMESCALEMOD"
      ]
    }
  },
  "codegen": {
    "static_binding": true
  },
  "sources": [
    "dual_clock_mailbox.sv"
  ],
  "clocks": [
    {
      "port": "write_clk",
      "source": "generated",
      "half_period": "2ns",
      "primary": true
    },
    {
      "port": "read_clk",
      "source": "generated",
      "half_period": "3ns",
      "phase": "1ns"
    }
  ],
  "run": {
    "init_function": "cpptb_dpi_init",
    "step_function": "cpptb_dpi_step",
    "next_deadline_function": "cpptb_dpi_next_timer_deadline",
    "iteration_plusarg": "CPPTB_MULTICLOCK_ITERS",
    "default_iterations": 16,
    "timeprecision": "1ps"
  },
  "path_rules": [
    {
      "prefix": "write_",
      "path": "write"
    },
    {
      "prefix": "read_",
      "path": "read"
    },
    {
      "prefix": "probe_",
      "path": "probe"
    }
  ],
  "type_names": {
    "": "DualClockMailboxDut",
    "write": "WriteDomain",
    "read": "ReadDomain",
    "probe": "PhaseProbe"
  },
  "outputs": {
    "cpp_dut": "generated/dual_clock_mailbox_dut.hpp",
    "cpp_binding": "generated/dual_clock_mailbox_binding.hpp",
    "sv_wrapper": "generated/dpi_dual_clock_mailbox.sv",
    "cpp_include": "cpptb/examples/dpi_multiclock/generated/dual_clock_mailbox_dut.hpp"
  }
}
