{
  "schema_version": 1,
  "module": "timer_only_probe",
  "top_module": "dpi_timer_only_probe",
  "namespace": "cpptb::examples::dpi_timer_only",
  "root_type": "TimerOnlyProbeDut",
  "frontend": "slang",
  "frontend_options": {
    "slang": {
      "standard": "1800-2023"
    },
    "verilator_json": {
      "args": [
        "-Wno-TIMESCALEMOD"
      ]
    }
  },
  "codegen": {
    "static_binding": true
  },
  "sources": [
    "timer_only_probe.sv"
  ],
  "clocks": [],
  "run": {
    "init_function": "cpptb_dpi_init",
    "step_function": "cpptb_dpi_step",
    "next_deadline_function": "cpptb_dpi_next_timer_deadline",
    "iteration_plusarg": "CPPTB_TIMER_ONLY_ITERS",
    "default_iterations": 9,
    "timeprecision": "1ps"
  },
  "path_rules": [
    {
      "prefix": "fast_",
      "path": "fast"
    },
    {
      "prefix": "slow_",
      "path": "slow"
    }
  ],
  "type_names": {
    "": "TimerOnlyProbeDut",
    "fast": "FastCadenceProbe",
    "slow": "SlowCadenceProbe"
  },
  "outputs": {
    "cpp_dut": "generated/timer_only_probe_dut.hpp",
    "cpp_binding": "generated/timer_only_probe_binding.hpp",
    "sv_wrapper": "generated/dpi_timer_only_probe.sv",
    "cpp_include": "cpptb/examples/dpi_timer_only/generated/timer_only_probe_dut.hpp"
  }
}
